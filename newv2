-- == DRAG SYSTEM (ANTI-STICK) ==
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
TopBar.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then update(input) end end)

-- == DATA LOGIC ==
local State = ReplicatedStorage:WaitForChild("State", 10)
local pathNodes = {}

local function cachePaths()
    local map = Workspace:FindFirstChild("Map")
    local pathsFolder = map and map:FindFirstChild("Paths")
    if pathsFolder then
        local mainPath = pathsFolder:FindFirstChild("1") or pathsFolder:GetChildren()[1]
        if mainPath then
            local nodes = mainPath:GetChildren()
            table.sort(nodes, function(a,b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
            for _, part in ipairs(nodes) do table.insert(pathNodes, part.Position) end
        end
    end
end
cachePaths()

local function getEnemies()
    local enemies_data = {}
    local npcsFolder = Workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, mob in ipairs(npcsFolder:GetChildren()) do
            if string.match(mob.Name, "Enemy$") or mob.Name == "Boss" or mob.Name == "NecromancerBoss" then
                local hum, root = mob:FindFirstChild("Humanoid"), mob:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local endPoint = pathNodes[#pathNodes] or root.Position
                    local dist = (root.Position - endPoint).Magnitude
                    table.insert(enemies_data, {
                        Name = mob.Name, Health = hum.Health, MaxHealth = hum.MaxHealth,
                        Speed = hum.WalkSpeed, Dist = math.floor(dist),
                        Pos = {x=math.floor(root.Position.X), y=math.floor(root.Position.Y), z=math.floor(root.Position.Z)}
                    })
                end
            end
        end
    end
    return enemies_data
end

-- == MEGA TOWER STATS ==
local function getTowers()
    local my_towers = {}
    local towersFolder = Workspace:FindFirstChild("Towers")
    if towersFolder then
        for _, tower in ipairs(towersFolder:GetChildren()) do
            local ownerVal = tower:FindFirstChild("Owner")
            if ownerVal and ownerVal.Value == Player.UserId then
                local root = tower:FindFirstChild("HumanoidRootPart")
                local replicator = tower:FindFirstChild("Replicator")
                
                if root and replicator then
                    local attr = replicator:GetAttributes()
                    
                    local level = attr["Level"] or 0
                    local dmgDealt = attr["DamageDealt"] or 0
                    local investment = attr["TotalInvestment"] or 0
                    local sellPrice = math.floor(investment * 0.5)
                    local currDmg = attr["Damage"] or 0
                    local range = attr["Range"] or 0
                    local cooldown = attr["Firerate"] or 0
                    
                    local upgCost = "Full"
                    if level < 5 then upgCost = attr["NextUpgradeCost"] or "Unknown" end

                    local bonuses = {}
                    if attr["Camo"] or attr["Hidden"] then table.insert(bonuses, "Hidden") end
                    if attr["Flying"] or attr["Lead"] then table.insert(bonuses, "Flying") end
                    if #bonuses == 0 then table.insert(bonuses, "None") end

                    table.insert(my_towers, {
                        Name = tower.Name,
                        Level = level,
                        Pos = {x = math.floor(root.Position.X), y = math.floor(root.Position.Y), z = math.floor(root.Position.Z)},
                        Stats = {
                            DmgDealt = dmgDealt, Sell = sellPrice, Cost = investment,
                            Upgrade = upgCost, Dmg = currDmg, Rng = range, Cd = cooldown,
                            Bonus = table.concat(bonuses, ", ")
                        }
                    })
                end
            end
        end
    end
    return my_towers
end

-- == CASH FIX (HOTBAR) ==
local function getGameStats()
    local info = {Wave=0, Health=0, Cash=0}
    pcall(function()
        if State then
            if State:FindFirstChild("Wave") then info.Wave = State.Wave.Value end
            if State:FindFirstChild("Health") then info.Health = State.Health.Current.Value end
        end
    end)
    pcall(function()
        local hotbar = PlayerGui:FindFirstChild("ReactUniversalHotbar")
        if hotbar and hotbar:FindFirstChild("Frame") then
            local amountLabel = hotbar.Frame.values.cash.amount
            if amountLabel and amountLabel:IsA("TextLabel") then
                local clean = amountLabel.Text:gsub("%$", ""):gsub(",", ""):gsub(" ", "")
                local num = tonumber(clean)
                if num then info.Cash = num end
            end
        end
    end)
    return info
end

task.spawn(function()
    while task.wait(0.1) do
        local stats = getGameStats()
        InfoLabel.Text = "Wave: " .. stats.Wave .. "\nHealth: " .. stats.Health .. "\nCash: $" .. stats.Cash
        
        if request_func then
            local payload = {Type = "MATCH_UPDATE", Stats = stats, Enemies = getEnemies(), Towers = getTowers()}
            local s, r = pcall(function() return request_func({Url=SERVER_URL.."/match_data", Method="POST", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode(payload)}) end)
            
            if s and r.StatusCode == 200 then
                PyStatus.Text = "PYTHON: Connected ✅"; PyStatus.TextColor3 = Color3.fromRGB(50, 255, 100)
            else
                PyStatus.Text = "PYTHON: Disconnected ❌"; PyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
        end
    end
end)
