local State = ReplicatedStorage:WaitForChild("State", 10)
local pathNodes = {}

local function cachePaths()
    local map = Workspace:FindFirstChild("Map")
    local pathsFolder = map and map:FindFirstChild("Paths")
    if pathsFolder then
        local mainPath = pathsFolder:FindFirstChild("1") or pathsFolder:GetChildren()[1]
        if mainPath then
            local nodes = mainPath:GetChildren()
            table.sort(nodes, function(a,b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
            for _, part in ipairs(nodes) do table.insert(pathNodes, part.Position) end
        end
    end
end
cachePaths()

local function getEnemies()
    local enemies_data = {}
    local npcsFolder = Workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, mob in ipairs(npcsFolder:GetChildren()) do
            if string.match(mob.Name, "Enemy$") or mob.Name == "Boss" or mob.Name == "NecromancerBoss" then
                local hum, root = mob:FindFirstChild("Humanoid"), mob:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local endPoint = pathNodes[#pathNodes] or root.Position
                    local dist = (root.Position - endPoint).Magnitude
                    table.insert(enemies_data, {
                        Name = mob.Name, Health = hum.Health, MaxHealth = hum.MaxHealth,
                        Speed = hum.WalkSpeed, Dist = math.floor(dist),
                        Pos = {x=math.floor(root.Position.X), y=math.floor(root.Position.Y), z=math.floor(root.Position.Z)}
                    })
                end
            end
        end
    end
    return enemies_data
end

local function getTowers()
    local my_towers = {}
    local towersFolder = Workspace:FindFirstChild("Towers")
    if towersFolder then
        for _, tower in ipairs(towersFolder:GetChildren()) do
            local ownerVal = tower:FindFirstChild("Owner")
            if ownerVal and ownerVal.Value == Player.UserId then
                local lvl = 0
                if tower:FindFirstChild("Replicator") and tower.Replicator:GetAttribute("Level") then lvl = tower.Replicator:GetAttribute("Level")
                elseif tower:GetAttribute("Level") then lvl = tower:GetAttribute("Level") end
                local target = "First"
                if tower:FindFirstChild("Target") then target = tower.Target.Value end
                local root = tower:FindFirstChild("HumanoidRootPart")
                if root then
                    table.insert(my_towers, {
                        Name = tower.Name, Level = lvl, Target = target,
                        Pos = {x=math.floor(root.Position.X), z=math.floor(root.Position.Z)}
                    })
                end
            end
        end
    end
    return my_towers
end

-- === ИСПРАВЛЕННАЯ ФУНКЦИЯ ПОЛУЧЕНИЯ СТАТОВ ===
local function getGameStats()
    local info = {Wave=0, Health=0, Cash=0}
    pcall(function()
        -- 1. Wave & Health from State
        if State then
            if State:FindFirstChild("Wave") then info.Wave = State.Wave.Value end
            if State:FindFirstChild("Health") then info.Health = State.Health.Current.Value end
        end
        
        -- 2. CASH FIX (Проверяем все возможные варианты)
        -- Вариант А: Leaderstats (Часто используется в матчах)
        if Player:FindFirstChild("leaderstats") and Player.leaderstats:FindFirstChild("Cash") then
            info.Cash = Player.leaderstats.Cash.Value
        
        -- Вариант Б: Твой путь
        elseif Player:FindFirstChild("Cash") then 
            info.Cash = Player.Cash.Value
            
        -- Вариант В: GUI (Самый надежный запасной вариант)
        else
            local gui = PlayerGui:FindFirstChild("GameGui")
            if gui then
                local cashObj = gui:FindFirstChild("Money", true) or gui:FindFirstChild("Cash", true)
                if cashObj and cashObj:IsA("TextLabel") then
                    -- Удаляем знак $ и запятые, чтобы получить чистое число
                    local txt = cashObj.Text:gsub("%$", ""):gsub(",", "")
                    info.Cash = tonumber(txt) or 0
                end
            end
        end
    end)
    return info
end

