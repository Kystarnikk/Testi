local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer
local SERVER_URL = "http://127.0.0.1:5000"
local request_func = (syn and syn.request) or (http and http.request) or (http_request) or (fluxus and fluxus.request) or request
local Remote = ReplicatedStorage:WaitForChild("RemoteFunction")

local LiveStats = {Wave = "0 / 0", Health = 0, Cash = 0}

-- ПЕРЕХВАТ ВОЛН
task.spawn(function()
    local sb = ReplicatedStorage:WaitForChild("Network"):WaitForChild("Sandbox")
    sb:WaitForChild("RE:SetStats").OnClientEvent:Connect(function(d)
        if type(d) == "table" then
            local cur = d.Wave or 0
            local max = d.MaxWave or (d.WavesLeft and cur + d.WavesLeft) or "?"
            LiveStats.Wave = cur .. " / " .. max
            if d.Health then LiveStats.Health = d.Health end
        end
    end)
end)

local function getTowers()
    local t = {}
    if workspace:FindFirstChild("Towers") then
        for _, v in ipairs(workspace.Towers:GetChildren()) do
            if v:FindFirstChild("Owner") and v.Owner.Value == Player.UserId and v:FindFirstChild("Replicator") then
                local a, r = v.Replicator:GetAttributes(), v:FindFirstChild("HumanoidRootPart")
                if r then table.insert(t, {Name=v.Name, Level=a.Level or 0, Pos={x=math.floor(r.Position.X), z=math.floor(r.Position.Z)}, Stats={Cost=a.TotalInvestment or 0, DmgDealt=a.DamageDealt or 0}}) end
            end
        end
    end
    return t
end

local MatchConfig = {mode = "Easy", autoskip = false}
task.spawn(function()
    if request_func then
        local s, r = pcall(function() return request_func({Url=SERVER_URL.."/get_match_config", Method="GET"}) end)
        if s then
            MatchConfig = HttpService:JSONDecode(r.Body)
            task.wait(2); Remote:InvokeServer("Difficulty", "Vote", MatchConfig.mode)
            task.wait(1); Remote:InvokeServer("Difficulty", "Ready")
        end
    end
end)

local lastSkip = 0
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local h = Player.PlayerGui:FindFirstChild("ReactUniversalHotbar")
            if h then LiveStats.Cash = tonumber(h.Frame.values.cash.amount.Text:gsub("%D","")) or 0 end
        end)
        if MatchConfig.autoskip and tick() - lastSkip > 3 then Remote:InvokeServer("Voting", "Skip"); lastSkip = tick() end
        if request_func then pcall(function() request_func({Url=SERVER_URL.."/match_data", Method="POST", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode({Stats=LiveStats, Towers=getTowers()})}) end) end
    end
end)
