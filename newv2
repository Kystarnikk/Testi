local pathNodes = {}
local function cachePaths()
    local map = Workspace:FindFirstChild("Map")
    local pF = map and map:FindFirstChild("Paths")
    if pF then
        local mP = pF:FindFirstChild("1") or pF:GetChildren()[1]
        local nodes = mP:GetChildren(); table.sort(nodes, function(a,b) return (tonumber(a.Name) or 0)<(tonumber(b.Name) or 0) end)
        for _, p in ipairs(nodes) do table.insert(pathNodes, p.Position) end
    end
end
cachePaths()

local function getTowers()
    local t = {}
    if Workspace:FindFirstChild("Towers") then
        for _, tower in ipairs(Workspace.Towers:GetChildren()) do
            if tower:FindFirstChild("Owner") and tower.Owner.Value == Player.UserId and tower:FindFirstChild("Replicator") then
                local attr = tower.Replicator:GetAttributes()
                local root = tower:FindFirstChild("HumanoidRootPart")
                if root then
                    table.insert(t, {
                        Name = tower.Name, Level = attr["Level"] or 0,
                        Pos = {x=math.floor(root.Position.X), z=math.floor(root.Position.Z)},
                        Stats = {DmgDealt = attr["DamageDealt"] or 0, Sell = math.floor((attr["TotalInvestment"] or 0)*0.5), Cost = attr["TotalInvestment"] or 0, Upgrade = (attr["Level"] or 0)<5 and (attr["NextUpgradeCost"] or "Unknown") or "Full", Dmg = attr["Damage"] or 0, Cd = attr["Firerate"] or 0, Rng = attr["Range"] or 0, Bonus = (attr["Hidden"] and "Hidden" or "")..(attr["Flying"] and "Flying" or "")}
                    })
                end
            end
        end
    end
    return t
end

-- == SEARCH FUNCTIONS (THE "VACUUM CLEANER") ==
-- Эта функция ищет текст внутри Hotbar, не зная точного пути
local function findStatInHotbar(keyword)
    local hotbar = PlayerGui:FindFirstChild("ReactUniversalHotbar")
    if not hotbar then return nil end
    
    -- Ищем глубоко внутри всех папок
    for _, v in ipairs(hotbar:GetDescendants()) do
        if v:IsA("TextLabel") then
            -- Если это деньги (содержит $)
            if keyword == "Cash" and v.Text:find("%$") then
                return v.Text
            end
            -- Если это ХП (родитель называется health)
            if keyword == "Health" and v.Parent and v.Parent.Name == "health" then
                 return v.Text
            end
        end
    end
    return nil
end

local function getStats()
    local info = {Wave="...", Health=0, Cash=0}
    
    -- 1. WAVE (State - Самый надежный)
    pcall(function()
        local State = ReplicatedStorage:FindFirstChild("State")
        if State then
            local w = State:FindFirstChild("Wave") and State.Wave.Value or 0
            local m = State:FindFirstChild("MaxWave") and State.MaxWave.Value or State:FindFirstChild("SurvivalWave") and State.SurvivalWave.Value or "?"
            info.Wave = w .. " / " .. m
            
            -- Если ХП есть в State, берем оттуда
            if State:FindFirstChild("Health") then info.Health = State.Health.Current.Value end
        end
    end)
    
    -- 2. CASH (Ищем везде в хотбаре текст с "$")
    pcall(function()
        local cashTxt = findStatInHotbar("Cash")
        if cashTxt then
            local clean = cashTxt:gsub("%$", ""):gsub(",", ""):gsub(" ", "")
            info.Cash = tonumber(clean) or info.Cash
        end
    end)
    
    return info
end

