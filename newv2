if not game:IsLoaded() then game.Loaded:Wait() end
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer

local SERVER_URL = "http://127.0.0.1:5000"
local request_func = (syn and syn.request) or (http and http.request) or (http_request) or (fluxus and fluxus.request) or request

local LiveStats = {Wave = "0 / 0", Health = 0, Cash = 0}

-- == Monitor Loop ==
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            -- 1. Считываем Волну (Путь по твоему скриншоту)
            local topGui = Player.PlayerGui:FindFirstChild("ReactGameTopGameDisplay")
            if topGui then
                local waveValue = topGui.Frame.wave.container.value
                LiveStats.Wave = waveValue.Text -- Получаем текст типа "1 / 25"
            end

            -- 2. Считываем ХП Базы
            local state = ReplicatedStorage:FindFirstChild("State")
            if state and state:FindFirstChild("Health") then
                LiveStats.Health = state.Health.Current.Value
            end

            -- 3. Считываем Деньги
            local hotbar = Player.PlayerGui:FindFirstChild("ReactUniversalHotbar")
            if hotbar then
                local cashText = hotbar.Frame.values.cash.amount.Text
                LiveStats.Cash = cashText:gsub("%D", "") -- Убираем символ $
            end
        end)

        -- Отправляем данные на сервер
        if request_func then
            pcall(function()
                request_func({
                    Url = SERVER_URL .. "/match_data",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({Stats = LiveStats})
                })
            end)
        end
    end
end)

print("Combat script loaded. Wave monitoring active.")
