-- == DATA COLLECTORS ==
local pathNodes = {}
local function cachePaths()
    local map = Workspace:FindFirstChild("Map")
    local pF = map and map:FindFirstChild("Paths")
    if pF then
        local mP = pF:FindFirstChild("1") or pF:GetChildren()[1]
        local nodes = mP:GetChildren(); table.sort(nodes, function(a,b) return (tonumber(a.Name) or 0)<(tonumber(b.Name) or 0) end)
        for _, p in ipairs(nodes) do table.insert(pathNodes, p.Position) end
    end
end
cachePaths()

local function getTowers()
    local t = {}
    if Workspace:FindFirstChild("Towers") then
        for _, tower in ipairs(Workspace.Towers:GetChildren()) do
            if tower:FindFirstChild("Owner") and tower.Owner.Value == Player.UserId and tower:FindFirstChild("Replicator") then
                local attr = tower.Replicator:GetAttributes()
                local root = tower:FindFirstChild("HumanoidRootPart")
                if root then
                    table.insert(t, {
                        Name = tower.Name, Level = attr["Level"] or 0,
                        Pos = {x=math.floor(root.Position.X), z=math.floor(root.Position.Z)},
                        Stats = {DmgDealt = attr["DamageDealt"] or 0, Sell = math.floor((attr["TotalInvestment"] or 0)*0.5), Cost = attr["TotalInvestment"] or 0, Upgrade = (attr["Level"] or 0)<5 and (attr["NextUpgradeCost"] or "Unknown") or "Full", Dmg = attr["Damage"] or 0, Cd = attr["Firerate"] or 0, Rng = attr["Range"] or 0, Bonus = (attr["Hidden"] and "Hidden" or "")..(attr["Flying"] and "Flying" or "")}
                    })
                end
            end
        end
    end
    return t
end

-- == HYBRID STATS SYSTEM (TANK MODE) ==
local function getStats()
    local info = {Wave="Loading...", Health=0, Cash=0}
    
    -- БЛОК 1: ВНУТРЕННИЕ ДАННЫЕ (ReplicatedStorage) - Для Волн и ХП
    -- Это работает всегда, даже если GUI скрыт
    pcall(function()
        local State = ReplicatedStorage:FindFirstChild("State")
        if State then
            -- Волна
            local curr = State:FindFirstChild("Wave") and State.Wave.Value or 0
            local max = State:FindFirstChild("MaxWave") and State.MaxWave.Value 
                        or State:FindFirstChild("SurvivalWave") and State.SurvivalWave.Value 
                        or "?"
            info.Wave = tostring(curr) .. " / " .. tostring(max)
            
            -- Здоровье
            if State:FindFirstChild("Health") and State.Health:FindFirstChild("Current") then
                info.Health = State.Health.Current.Value
            end
        end
    end)
    
    -- БЛОК 2: GUI (PlayerGui) - Только для Денег
    -- Если этот блок сломается, скрипт НЕ остановится, просто деньги будут 0
    pcall(function()
        local hotbar = PlayerGui:FindFirstChild("ReactUniversalHotbar")
        if hotbar and hotbar:FindFirstChild("Frame") and hotbar.Frame:FindFirstChild("values") then
            if hotbar.Frame.values:FindFirstChild("cash") then
                local txt = hotbar.Frame.values.cash.amount.Text
                -- Чистим текст от всего, кроме цифр
                local clean = txt:gsub("%D", "") 
                info.Cash = tonumber(clean) or 0
            end
        end
    end)

    return info
end

-- == MAIN LOOP ==
local lastSkip = 0
task.spawn(function()
    print("✅ ЦИКЛ ЗАПУЩЕН")
    while task.wait(0.1) do
        -- Оборачиваем весь цикл в pcall, чтобы одна ошибка не убила скрипт
        local success, err = pcall(function()
            local stats = getStats()
            InfoLabel.Text = "Wave: " .. stats.Wave .. "\nHealth: " .. stats.Health .. "\nCash: $" .. stats.Cash
            
            -- Auto Skip
            if MatchConfig.autoskip and tick()-lastSkip > 3 then
                Remote:InvokeServer("Voting", "Skip"); lastSkip=tick()
            end
            
            -- Sending Data
            if request_func then
                local payload = {Type="MATCH", Stats=stats, Enemies={}, Towers=getTowers()}
                request_func({Url=SERVER_URL.."/match_data", Method="POST", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode(payload)})
            end
        end)
        
        if not success then
            warn("⚠️ ОШИБКА В ЦИКЛЕ: " .. tostring(err))
            task.wait(1) -- Ждем секунду перед повтором, чтобы не крашнуть игру
        end
    end
end)
