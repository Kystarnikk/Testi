-- == DATA ==
local pathNodes = {}
local function cachePaths()
    local map = Workspace:FindFirstChild("Map")
    local pF = map and map:FindFirstChild("Paths")
    if pF then
        local mP = pF:FindFirstChild("1") or pF:GetChildren()[1]
        local nodes = mP:GetChildren(); table.sort(nodes, function(a,b) return (tonumber(a.Name) or 0)<(tonumber(b.Name) or 0) end)
        for _, p in ipairs(nodes) do table.insert(pathNodes, p.Position) end
    end
end
cachePaths()

local function getTowers()
    local t = {}
    if Workspace:FindFirstChild("Towers") then
        for _, tower in ipairs(Workspace.Towers:GetChildren()) do
            if tower:FindFirstChild("Owner") and tower.Owner.Value == Player.UserId and tower:FindFirstChild("Replicator") then
                local attr = tower.Replicator:GetAttributes()
                local root = tower:FindFirstChild("HumanoidRootPart")
                if root then
                    table.insert(t, {
                        Name = tower.Name, Level = attr["Level"] or 0,
                        Pos = {x=math.floor(root.Position.X), z=math.floor(root.Position.Z)},
                        Stats = {DmgDealt = attr["DamageDealt"] or 0, Sell = math.floor((attr["TotalInvestment"] or 0)*0.5), Cost = attr["TotalInvestment"] or 0, Upgrade = (attr["Level"] or 0)<5 and (attr["NextUpgradeCost"] or "Unknown") or "Full", Dmg = attr["Damage"] or 0, Cd = attr["Firerate"] or 0, Rng = attr["Range"] or 0, Bonus = (attr["Hidden"] and "Hidden" or "")..(attr["Flying"] and "Flying" or "")}
                    })
                end
            end
        end
    end
    return t
end

-- == STATS FIX ==
local function getStats()
    local info = {Wave="WAITING...", Health=0, Cash=0}
    
    pcall(function()
        local h = PlayerGui:FindFirstChild("ReactUniversalHotbar")
        if h and h:FindFirstChild("Frame") then
            -- 1. ДЕНЬГИ (Мы знаем, что это работает)
            if h.Frame:FindFirstChild("values") and h.Frame.values:FindFirstChild("cash") then
                 local txt = h.Frame.values.cash.amount.Text
                 info.Cash = tonumber(txt:gsub("%$",""):gsub(",",""):gsub(" ","")) or 0
            end
            
            -- 2. ВОЛНЫ (Попытка найти их в том же Hotbar)
            -- Обычно структура такая: Frame -> values -> wave -> amount
            -- ИЛИ: Frame -> info -> wave
            if h.Frame:FindFirstChild("values") and h.Frame.values:FindFirstChild("wave") then
                info.Wave = h.Frame.values.wave.amount.Text
            elseif h.Frame:FindFirstChild("info") and h.Frame.info:FindFirstChild("wave") then
                info.Wave = h.Frame.info.wave.Text
            else
                -- ЗАПАСНОЙ ВАРИАНТ: State
                local State = ReplicatedStorage:FindFirstChild("State")
                if State and State:FindFirstChild("Wave") then
                     local w = State.Wave.Value
                     local max = State:FindFirstChild("MaxWave") and State.MaxWave.Value or "?"
                     info.Wave = w .. " / " .. max
                end
            end
            
            -- 3. HEALTH (Тоже ищем в Hotbar или State)
            if h.Frame:FindFirstChild("values") and h.Frame.values:FindFirstChild("health") then
                local ht = h.Frame.values.health.amount.Text
                info.Health = tonumber(ht) or 0
            else
                local State = ReplicatedStorage:FindFirstChild("State")
                if State and State:FindFirstChild("Health") then info.Health = State.Health.Current.Value end
            end
        end
    end)
    return info
end

