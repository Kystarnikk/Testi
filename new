local towers = {"Scout", "Paintballer", "Sniper", "Demoman", "Hunter", "Soldier", "Militant", "Crook Boss", "Freezer", "Assassin", "Shotgunner", "Pyromancer", "Ace Pilot", "Medic", "Farm", "Rocketeer", "Trapper", "Military Base", "Mortar", "Turret", "Mercenary Base", "Electroshocker", "Warden", "Cowboy", "Commander", "DJ Booth", "Minigunner", "Ranger", "Pursuit", "Gatling Gun", "Brawler", "Necromancer", "Accelerator", "Engineer", "Hacker", "Snowballer", "Executioner", "Swarmer"}
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer
local Remote = ReplicatedStorage:WaitForChild("RemoteFunction")
local SERVER_URL = "http://127.0.0.1:5000"
local request_func = (syn and syn.request) or (http and http.request) or (http_request) or (fluxus and fluxus.request) or request

local function checkAll()
    repeat task.wait(1) until Player:FindFirstChild("Level") and Player:FindFirstChild("Coins")
    local inv = {}
    for _, n in ipairs(towers) do pcall(function() Remote:InvokeServer("Inventory", "Unequip", "tower", n) end) end
    task.wait(0.5)
    for _, n in ipairs(towers) do
        local s, r = pcall(function() return Remote:InvokeServer("Inventory", "Equip", "tower", n) end)
        inv[n] = (s and r ~= false)
        task.wait(0.05)
    end
    local stats = {
        Triumphs = Player:FindFirstChild("Triumphs") and Player.Triumphs.Value or 0,
        Loses = Player:FindFirstChild("Loses") and Player.Loses.Value or 0,
        Coins = Player:FindFirstChild("Coins") and Player.Coins.Value or 0,
        Gems = Player:FindFirstChild("Gems") and Player.Gems.Value or 0,
        Level = Player.Level.Value
    }
    if request_func then pcall(function() request_func({Url=SERVER_URL.."/update", Method="POST", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode({stats=stats, inventory=inv})}) end) end
end
task.spawn(checkAll)
