-- 2. Сбор предметов
local itemSpawns = workspace:FindFirstChild("Item_Spawns")
if itemSpawns then
    local itemsFolder = itemSpawns:FindFirstChild("Items")
    if itemsFolder then
        local items = itemsFolder:GetChildren()
        
        if #items > 0 then
            notify("Сбор", "Найдено предметов: " .. #items)
            
            for _, item in ipairs(items) do
                local pos = nil
                if item:IsA("Model") then
                    pos = item:GetPivot().Position
                elseif item:IsA("BasePart") then
                    pos = item.Position
                end
                
                if pos then
                    -- Тпхаемся к предмету
                    mobileTeleport(pos)
                    
                    -- Ждем 0.5 секунды перед тем, как забрать
                    task.wait(0.5)
                    
                    -- Забираем предмет
                    for _, obj in ipairs(item:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            mobilePrompt(obj)
                            task.wait(0.1)
                        end
                    end
                end
            end
        else
            notify("Статус", "В папке Items пусто.")
        end
    else
        notify("Ошибка", "Папка Items не найдена!")
    end
else
    notify("Ошибка", "Папка Item_Spawns не найдена!")
end

