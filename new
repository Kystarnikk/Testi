-- == Functions ==
local function sendUpdate()
    local stats = {
        Level = Player:FindFirstChild("Level") and Player.Level.Value or 0,
        Exp = Player:FindFirstChild("Experience") and Player.Experience.Value or 0,
        Coins = Player:FindFirstChild("Coins") and Player.Coins.Value or 0,
        Gems = Player:FindFirstChild("Gems") and Player.Gems.Value or 0,
        Triumphs = Player:FindFirstChild("Triumphs") and Player.Triumphs.Value or 0,
        Loses = Player:FindFirstChild("Loses") and Player.Loses.Value or 0
    }
    
    if request_func then 
        pcall(function() 
            request_func({
                Url = SERVER_URL .. "/update",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({stats = stats})
            }) 
        end) 
    end
end

local function checkCommands()
    if not request_func then return end
    local success, response = pcall(function()
        return request_func({Url = SERVER_URL .. "/get_cmd", Method = "GET"})
    end)

    if success and response.StatusCode == 200 then
        local cmd = HttpService:JSONDecode(response.Body)
        if cmd.pending then
            StatusLabel.Text = "Status: Starting Game..."
            -- Здесь можно добавить твой код для входа в лифт
        end
    end
end

-- == Loops ==
task.spawn(function()
    while task.wait(5) do
        sendUpdate()
        checkCommands()
    end
end)
