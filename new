local function sendUpdate()
    local expVal = Player:FindFirstChild("Experience") or Player:FindFirstChild("Exp")
    local stats = {
        Level = Player.Level.Value,
        Exp = expVal and expVal.Value or 0,
        Coins = Player:FindFirstChild("Coins") and Player.Coins.Value or 0,
        Gems = Player:FindFirstChild("Gems") and Player.Gems.Value or 0,
        Triumphs = Player:FindFirstChild("Triumphs") and Player.Triumphs.Value or 0,
        Loses = Player:FindFirstChild("Loses") and Player.Loses.Value or 0
    }
    if request_func then pcall(function() request_func({Url = SERVER_URL .. "/update", Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode({stats = stats, inventory = inventory_data})}) end) end
end

local function StartCheck()
    for _, name in ipairs(towers) do
        local s, r = pcall(function() return Remote:InvokeServer("Inventory", "Equip", "tower", name) end)
        local has = (s and r ~= false); inventory_data[name] = has
        if rows[name] then rows[name].Image = has and "rbxassetid://6031068426" or "rbxassetid://6031094678"; rows[name].ImageColor3 = has and Color3.new(0,1,0) or Color3.new(1,0,0) end
        task.wait(0.05)
    end
    sendUpdate()
end

