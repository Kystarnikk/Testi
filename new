UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then d=false end end)

-- === ЛОГИКА ===
local function checkInventory()
    Status.Text = "Status: Checking Inventory..."; Status.TextColor3 = Color3.new(1, 0.5, 0)
    repeat task.wait(1) until Player:FindFirstChild("Level") and Player:FindFirstChild("Coins")
    
    local inv = {}
    -- Снимаем всё
    for _, n in ipairs(towers) do pcall(function() Remote:InvokeServer("Inventory", "Unequip", "tower", n) end) end
    task.wait(0.5)

    -- Надеваем и проверяем
    for _, n in ipairs(towers) do
        local s, r = pcall(function() return Remote:InvokeServer("Inventory", "Equip", "tower", n) end)
        local has = (s and r ~= false)
        inv[n] = has
        if rows[n] then 
            rows[n].Text = has and "✅" or "❌" 
            rows[n].TextColor3 = has and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
        end
        task.wait(0.05)
    end

    local stats = {
        Triumphs = Player:FindFirstChild("Triumphs") and Player.Triumphs.Value or 0,
        Loses = Player:FindFirstChild("Loses") and Player.Loses.Value or 0,
        Coins = Player:FindFirstChild("Coins") and Player.Coins.Value or 0,
        Gems = Player:FindFirstChild("Gems") and Player.Gems.Value or 0,
        Level = Player.Level.Value
    }

    if request_func then
        local success, res = pcall(function()
            return request_func({
                Url = SERVER_URL .. "/update",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({stats = stats, inventory = inv})
            })
        end)
        
        if success then
            Status.Text = "Status: Connected to Python!"; Status.TextColor3 = Color3.new(0, 1, 0)
        else
            Status.Text = "Status: Python Server Offline!"; Status.TextColor3 = Color3.new(1, 0, 0)
        end
    end
end

Btn.MouseButton1Click:Connect(checkInventory)
task.spawn(checkInventory)
