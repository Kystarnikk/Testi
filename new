-- === LOGIC: INVENTORY ===
local function checkInventory()
    repeat task.wait(1) until Player:FindFirstChild("Level")
    Status.Text = "Status: Checking Inventory..."; local inv = {}
    for _, n in ipairs(towers) do pcall(function() Remote:InvokeServer("Inventory", "Unequip", "tower", n) end) end
    for _, n in ipairs(towers) do
        local s, r = pcall(function() return Remote:InvokeServer("Inventory", "Equip", "tower", n) end)
        local has = (s and r ~= false); inv[n] = has
        if rows[n] then rows[n].Text = has and "OK" or "X"; rows[n].TextColor3 = has and Color3.new(0,1,0) or Color3.new(1,0,0) end
        task.wait(0.02)
    end
    local stats = {Triumphs=Player.Triumphs.Value, Loses=Player.Loses.Value, Coins=Player.Coins.Value, Gems=Player.Gems.Value, Level=Player.Level.Value}
    if request_func then pcall(function() request_func({Url=SERVER_URL.."/update", Method="POST", Headers={["Content-Type"]="application/json"}, Body=HttpService:JSONEncode({stats=stats, inventory=inv})}) end) end
    Status.Text = "Status: Connected to Python"; Status.TextColor3 = Color3.new(0,1,0)
end

-- === LOGIC: TELEPORT ===
local isSearching = false
local function pollCommands()
    if isSearching then return end
    task.spawn(function()
        if not request_func then return end
        local success, res = pcall(function() return request_func({Url=SERVER_URL.."/get_cmd", Method="GET"}) end)
        if success and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            if data.pending then
                isSearching = true
                local targetMap = data.map
                local targetCat = data.category
                Status.Text = "Searching Lift: " .. targetMap
                
                while isSearching do
                    for _, elev in ipairs(workspace:WaitForChild("Elevators"):GetChildren()) do
                        pcall(function()
                            local surface = elev.Screen.SurfaceGui.content
                            local players = surface.timer.players.Text
                            local isFree = (players == "0/4" or players == "0/1") and surface.timer.state.Text ~= "Teleporting"
                            
                            local mapFound = false
                            if targetMap == "RANDOM" then
                                if surface.mode.Text:upper() == targetCat:upper() then mapFound = true end
                            else
                                if surface.title.Text == targetMap then mapFound = true end
                            end

                            if isFree and mapFound then
                                Status.Text = "Found Elevator! Joining..."
                                local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                                if root then root.CFrame = elev.Touch.CFrame + Vector3.new(0,3,0) end
                                task.wait(0.5)
                                EnterRemote:InvokeServer(elev)
                                isSearching = false
                            end
                        end)
                        if not isSearching then break end
                    end
                    task.wait(1.5)
                end
            end
        end
    end)
end

task.spawn(checkInventory)
task.spawn(function() while task.wait(2) do pollCommands() end end)
