local function sendUpdate()
    task.spawn(function()
        local stats = {
            Triumphs = Player:FindFirstChild("Triumphs") and Player.Triumphs.Value or 0,
            Loses = Player:FindFirstChild("Loses") and Player.Loses.Value or 0,
            Coins = Player:FindFirstChild("Coins") and Player.Coins.Value or 0,
            Gems = Player:FindFirstChild("Gems") and Player.Gems.Value or 0,
            Level = Player.Level.Value
        }
        local payload = {stats=stats, inventory=inventory_data}
        if request_func then pcall(function() request_func({Url=SERVER_URL.."/update",Method="POST",Headers={["Content-Type"]="application/json"},Body=HttpService:JSONEncode(payload)}) end) end
    end)
end

local function unequipAll() for _, n in ipairs(towers) do task.spawn(function() pcall(function() Remote:InvokeServer("Inventory", "Unequip", "tower", n) end) end) end end

local function StartCheck()
    if not Remote then return end
    unequipAll(); task.wait(1)
    for _, name in ipairs(towers) do
        if rows[name] then rows[name].Stat.ImageColor3=Color3.fromRGB(255,255,0) end
        local s, r = pcall(function() return Remote:InvokeServer("Inventory","Equip","tower",name) end)
        local has = (s and r ~= false)
        inventory_data[name] = has
        if rows[name] then rows[name].Stat.Image=has and "rbxassetid://6031068426" or "rbxassetid://6031094678"; rows[name].Stat.ImageColor3=has and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,60,60) end
        task.wait(0.05)
    end
    unequipAll(); sendUpdate()
end

local function pollCommands()
    task.spawn(function()
        if not request_func then return end
        local success, res = pcall(function() return request_func({Url=SERVER_URL.."/get_cmd", Method="GET"}) end)
        if success and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            
            if data.stop_signal then if isSearching then isSearching=false; StatusLabel.Text="⛔ STOPPED" end return end

            if data.pending and not isSearching then
                isSearching = true
                local targetMap, targetCat = data.map, data.category
                StatusLabel.Text = "🔍 Searching: " .. (targetMap == "RANDOM" and "Smart ("..targetCat..")" or targetMap)

                while isSearching do
                    local validElevators = {}
                    for _, elev in ipairs(workspace:WaitForChild("Elevators"):GetChildren()) do
                        pcall(function()
                            local surface = elev.Screen.SurfaceGui.content
                            local isFree = (surface.timer.players.Text=="0/4" or surface.timer.players.Text=="0/1") and surface.timer.state.Text~="Teleporting"
                            if isFree then
                                if targetMap == "RANDOM" then if surface.mode.Text:upper() == targetCat:upper() then table.insert(validElevators, elev) end
                                else if surface.title.Text == targetMap then table.insert(validElevators, elev) end end
                            end
                        end)
                    end
                    
                    if #validElevators > 0 then
                        local chosen = validElevators[math.random(1, #validElevators)]
                        StatusLabel.Text = "✅ Found! Teleporting..."
                        
                        if chosen:FindFirstChild("Touch") and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                            local root = Player.Character.HumanoidRootPart
                            local targetCF = chosen.Touch.CFrame + Vector3.new(0, 2, 0)
                            local attempts = 0
                            repeat
                                root.CFrame = targetCF; task.wait(0.1); attempts=attempts+1
                            until (root.Position - targetCF.Position).Magnitude < 5 or attempts > 15
                        end
                        
                        task.wait(0.5)
                        pcall(function() GetSizesRemote:InvokeServer() end)
                        task.wait(0.2)
                        pcall(function() SetSizeRemote:InvokeServer(unpack({1})) end)
                        task.wait(0.2)
                        
                        EnterRemote:InvokeServer(chosen)
                        isSearching = false; StatusLabel.Text = "🚀 Entering..."; break
                    end
                    
                    local stopCheck = pcall(function() local chk = request_func({Url=SERVER_URL.."/get_cmd", Method="GET"}) if HttpService:JSONDecode(chk.Body).stop_signal then isSearching = false end end)
                    if not isSearching then break end
                    task.wait(1.5)
                end
                if not isSearching and StatusLabel.Text ~= "🚀 Entering..." then StatusLabel.Text = "⛔ Cancelled" end
            end
        end
    end)
end

task.spawn(function() task.wait(3); StartCheck() end)
