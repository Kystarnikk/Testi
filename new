local function pollCommands()
    task.spawn(function()
        local success, res = pcall(function() return request_func({Url = SERVER_URL .. "/get_cmd", Method = "GET"}) end)
        if success and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            if data.pending and not isSearching then
                isSearching = true
                StatusLabel.Text = "Searching Lift..."
                while isSearching do
                    for _, elev in ipairs(workspace.Elevators:GetChildren()) do
                        pcall(function()
                            local surface = elev.Screen.SurfaceGui.content
                            if (surface.timer.players.Text == "0/4" or surface.timer.players.Text == "0/1") and surface.timer.state.Text ~= "Teleporting" then
                                if data.map == "RANDOM" or surface.title.Text == data.map then
                                    Player.Character.HumanoidRootPart.CFrame = elev.Touch.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.5)
                                    EnterRemote:InvokeServer(elev)
                                    isSearching = false
                                end
                            end
                        end)
                        if not isSearching then break end
                    end
                    task.wait(2)
                end
            end
        end
    end)
end

