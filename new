local SERVER_URL = "http://127.0.0.1:5000"
local towers = {"Scout", "Sniper", "Farm", "Minigunner", "Commander", "DJ Booth", "Accelerator"} -- Сократил для теста

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer

local Remote = ReplicatedStorage:WaitForChild("RemoteFunction")
local ElevNet = ReplicatedStorage:WaitForChild("Network"):WaitForChild("Elevators")
local EnterRF = ElevNet:WaitForChild("RF:Enter")

local isSearching = false
local request_func = (syn and syn.request) or (http and http.request) or request

local function getStatus()
    local success, res = pcall(function() return request_func({Url = SERVER_URL.."/get_cmd", Method = "GET"}) end)
    if success and res.StatusCode == 200 then return HttpService:JSONDecode(res.Body) end
    return nil
end

local function teleportToElevator(elev)
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = Player.Character.HumanoidRootPart
    local targetCF = elev.Touch.CFrame * CFrame.new(0, 3, 0)
    
    root.AssemblyLinearVelocity = Vector3.new(0,0,0) -- Стопаем инерцию
    local attempts = 0
    repeat
        root.CFrame = targetCF
        task.wait(0.1)
        attempts = attempts + 1
    until attempts > 10
end

local function mainLoop()
    while task.wait(2) do
        local cmd = getStatus()
        if not cmd then continue end
        
        if cmd.stop_signal then isSearching = false end
        
        if cmd.pending and not isSearching then
            isSearching = true
            print("🔍 Searching for map: " .. cmd.map)
            
            while isSearching do
                local found = nil
                for _, elev in ipairs(workspace.Elevators:GetChildren()) do
                    pcall(function()
                        local gui = elev.Screen.SurfaceGui.content
                        local playersCount = gui.timer.players.Text
                        local state = gui.timer.state.Text
                        local mapTitle = gui.title.Text
                        local mode = gui.mode.Text
                        
                        if (playersCount == "0/4" or playersCount == "0/1") and state ~= "Teleporting" then
                            if cmd.map == "RANDOM" then
                                if mode:upper() == cmd.category:upper() then found = elev end
                            elseif mapTitle == cmd.map then
                                found = elev
                            end
                        end
                    end)
                    if found then break end
                end
                
                if found then
                    teleportToElevator(found)
                    local entered = EnterRF:InvokeServer(found)
                    if entered then 
                        isSearching = false 
                        print("🚀 Teleporting to match...")
                        break 
                    end
                end
                task.wait(1)
                -- Проверка, не отменили ли задачу пока искали
                local check = getStatus()
                if not check or not check.pending or check.stop_signal then isSearching = false break end
            end
        end
    end
end

task.spawn(mainLoop)
print("✅ LOBBY BOT LOADED")
